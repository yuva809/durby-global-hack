# This site's own public URL — used for metadataBase / canonical links /
# opengraph images. Production value is https://hack.durby.tech
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# The main Durby product site, linked from the footer / nav ("Durby").
NEXT_PUBLIC_DURBY_URL=https://durby.tech

# External registration platform (Luma, Devpost, Typeform, etc). Swap this
# one value once the real registration flow is live — every "Register"
# button in the app reads from src/lib/config.ts, which reads this.
NEXT_PUBLIC_REGISTRATION_URL=https://forms.durby.tech/global-hack

# Event dates (and duration) are not decided yet. Leave
# NEXT_PUBLIC_EVENT_DATE_CONFIRMED unset (or "false") until they are — the
# Hero countdown stays hidden behind a "dates announced soon" placeholder
# while this is false, so a placeholder date here is never shown to
# visitors as if it were real. When the date is locked, set both:
NEXT_PUBLIC_EVENT_DATE_CONFIRMED=false
NEXT_PUBLIC_EVENT_START=2026-11-13T09:00:00+00:00

# Entry is paid. Pricing (base / early-bird / student tiers) isn't set
# yet — leave this false until it is, so the site shows "pricing
# announced soon" instead of inventing a number.
NEXT_PUBLIC_PRICING_ANNOUNCED=false

# Contact / community links.
NEXT_PUBLIC_CONTACT_EMAIL=hack@durby.tech
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/durby-hack
NEXT_PUBLIC_GITHUB_URL=https://github.com/durby
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/durby
